# Copy to .env (next to review.py) and fill in what you use.
# review.py loads it automatically; variables already set in your environment win.

# Which profile from models.json to use (default: "default" in models.json)
# AI_REVIEW_MODEL=claude-haiku-openrouter

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...

# Ollama server, if it is not running on this machine
# OLLAMA_BASE_URL=http://my-gpu-box:11434
# OLLAMA_API_KEY=
